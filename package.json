{
  "name": "dndpaste",
  "version": "0.11.0",
  "description": "Pokepaste-style plain-text format for D&D 5e builds: reference parser and canonical emitter",
  "license": "MIT",
  "type": "module",
  "main": "./dist/dndpaste.umd.cjs",
  "module": "./dist/src/dndpaste.js",
  "types": "./dist/src/dndpaste.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/dndpaste.d.ts",
      "import": "./dist/src/dndpaste.js",
      "require": "./dist/dndpaste.umd.cjs"
    },
    "./check": {
      "types": "./dist/src/check.d.ts",
      "import": "./dist/src/check.js"
    },
    "./sources": {
      "types": "./dist/src/sources.d.ts",
      "import": "./dist/src/sources.js"
    },
    "./extract": {
      "types": "./dist/src/extract.d.ts",
      "import": "./dist/src/extract.js"
    },
    "./data/srd/slots.json": "./data/srd/slots.json",
    "./data/supplement.json": "./data/supplement.json"
  },
  "files": [
    "dist",
    "bin",
    "SPEC.md",
    "data/srd/slots.json",
    "data/supplement.json",
    "NOTICE.md"
  ],
  "bin": {
    "dndpaste": "./bin/dndpaste.mjs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/umd.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "verify:site": "npm --prefix site run verify"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
