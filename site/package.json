{
  "name": "dndpaste-site",
  "private": true,
  "type": "module",
  "description": "The dndpaste share site: one Cloudflare Worker + KV (SITE.md)",
  "scripts": {
    "fonts": "node scripts/fonts.mjs",
    "build": "node scripts/build-client.mjs",
    "dev": "wrangler dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "check:bundle": "node scripts/check-bundle.mjs",
    "verify": "npm run build && npm run typecheck && npm run test && npm run check:bundle"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.162.0"
  }
}
